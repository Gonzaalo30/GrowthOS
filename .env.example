NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_AUTOPILOT_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Credencial OAuth de Google Cloud (planes Growth/Autopilot: conectar Search
# Console + Analytics). Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes en base64 para cifrar el refresh token guardado. Generar con: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Clave de API simple (no OAuth) de Google Cloud: activar "PageSpeed Insights API"
# y crear una clave en Credenciales. Usada para el análisis real de velocidad.
GOOGLE_PAGESPEED_API_KEY=
